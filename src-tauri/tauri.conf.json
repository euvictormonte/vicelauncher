{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neves Launcher",
  "mainBinaryName": "Neves Launcher",
  "version": "1.0.4",
  "identifier": "com.neveslauncher.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neves Launcher",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "center": true,
        "backgroundColor": "#0c0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://github.com https://avatars.githubusercontent.com data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/VILauncher/backgrounds/**",
          "$LOCALDATA/Neves Launcher/backgrounds/**",
          "$LOCALDATA/Mandyhub/backgrounds/**",
          "$LOCALDATA/VI Launcher/backgrounds/**",
          "$DATA/VILauncher/backgrounds/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Neves Launcher",
    "copyright": "GPL-3.0-or-later. Based on Mandyhub by Zettrox.",
    "shortDescription": "A launcher for community projects",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "signCommand": {
        "cmd": "node",
        "args": ["../scripts/sign-windows.mjs", "%1"]
      }
    },
    "licenseFile": "../LEGAL.md"
  }
}
